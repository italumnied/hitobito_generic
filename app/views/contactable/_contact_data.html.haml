-# Hide address fields from users without show_details permission

- contact ||= contactable
- can_show_details = can?(:show_details, contact)

%address
  = contactable.contact_name
  = render_extensions :contact_name_attrs
  = contact.primary_email
  = contact.all_additional_emails(only_public)
  = contact.all_phone_numbers(only_public)
  - unless contact.profession.blank?
    %div.profession
      %strong= Person.human_attribute_name(:profession)
      = contact.profession
  - if can_show_details
    = contactable.complete_address if postal
  = contact.all_additional_addresses(only_public)
  = render_extensions :address_attrs

.social
  = contact.all_social_accounts(only_public)

= render_extensions :additional_attrs
